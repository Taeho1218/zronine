# API 베이스 URL.
#   - 배포된 백엔드에 붙을 때: https://gonggu-community-backend.onrender.com
#   - 로컬 백엔드(localhost:8080)에 붙을 때: 비워두면 vite.config.js 의 프록시를 탄다.
VITE_API_BASE_URL=https://gonggu-community-backend.onrender.com

# 백엔드(MySQL 포함)를 띄우지 않고 화면만 확인할 때 true 로 두면
# src/api/mock.js 의 고정 데이터로 모든 요청이 처리된다.
VITE_USE_MOCK=false
